# Leave everything blank to run fully offline (heuristic parsing + templated feedback).
# Provider "auto" picks OpenAI if OPENAI_API_KEY is set, else Anthropic, else offline.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# auto | openai | anthropic | offline
LLM_PROVIDER=auto
# Optional model override (defaults: gpt-4o-mini for OpenAI, claude-sonnet-5-5 for Anthropic)
LLM_MODEL=

# auto | openai | offline   (Anthropic has no embeddings API, so use OpenAI or offline)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# Ranking: final = SEMANTIC_WEIGHT * embedding similarity + (1 - SEMANTIC_WEIGHT) * skill coverage
SEMANTIC_WEIGHT=0.5
MAX_UPLOAD_MB=5
# JOBS_FILE=data/jobs.json
